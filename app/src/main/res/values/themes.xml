<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Avus" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Launch theme: the Avus mark on the icon's navy, until the first frame is drawn. -->
    <style name="Theme.Avus.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/avus_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Avus</item>
    </style>
</resources>
